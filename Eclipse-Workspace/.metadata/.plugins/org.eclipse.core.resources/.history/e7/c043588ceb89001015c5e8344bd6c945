package projeto_javafx;

import javafx.application.Application;
import javafx.scene.Group;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.image.Image;
import javafx.scene.image.ImageView;
import javafx.scene.layout.HBox;
import javafx.scene.paint.Color;
import javafx.scene.shape.Rectangle;
import javafx.scene.shape.StrokeType;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.scene.text.Text;
import javafx.stage.Stage;

public class JavaFX_Exercicio01 extends Application {

	@Override
	public void start(Stage primaryStage) throws Exception {
		// Criando o no Root
		Group noRoot = new Group();
		criarComponentes(noRoot);
		// Criando a cena
		Scene cena = new Scene(noRoot, 600, 400, Color.CORNSILK);

		primaryStage.setTitle("Itens JavaFX");
		primaryStage.setScene(cena);
		primaryStage.show();
	}

	private void criarComponentes(Group noRoot) {
		// Componentes do noRoot
		HBox cmp01 = new HBox();
		Rectangle cmp02 = new Rectangle(100, 100, Color.AQUA);
		Text cmp03 = new Text("Dorm 6: \n200");
		Image img = new Image(getClass().getResource("images/Duke.png").toString());
		ImageView cmp04 = new ImageView(img);
		// Redmencionar a imagem
		cmp04.setFitWidth(100);// deixando com 100 pixels de largura
		// ajuste para não distorcer a imagem
		cmp04.setPreserveRatio(true);
		// Criandos os 3 botões
		Button btn01 = new Button("Say'Hello World!'");
		Button btn02 = new Button("222");
		Button btn03 = new Button("33333");
		// A,arrando os componentes
		noRoot.getChildren().addAll(cmp01, cmp02, cmp03, cmp04);
		cmp01.getChildren().addAll(btn01, btn02, btn03);
		// Ajustando posições botões
		cmp01.setLayoutY(300);
		cmp01.setPrefWidth(600);
		cmp01.setLayoutX(200);
		// Ajustando posições retangulo
		cmp02.setLayoutY(50);
		cmp02.setLayoutX(50);
		// Ajustando posições do texto
		// https://docs.oracle.com/javafx/2/text/jfxpub-text-.tm
		cmp03.setLayoutY(250);
		cmp03.setLayoutX(230);
		cmp03.setFont(Font.font("Verdana", FontWeight.BOLD, 30));
		cmp03.setFill(Color.RED);
		cmp03.setStroke(Color.BLACK);// Contorno do texto
		cmp03.setStrokeWidth(5);//Espessura do contorno
		cmp03.setStrokeType(StrokeType.OUTSIDE);//Setando o contorno para fora
		// Ajustando posições do Duke
		cmp04.setLayoutY(20);
		cmp04.setLayoutX(450);
	}

	public static void main(String[] args) {
		launch(args);
	}

}
