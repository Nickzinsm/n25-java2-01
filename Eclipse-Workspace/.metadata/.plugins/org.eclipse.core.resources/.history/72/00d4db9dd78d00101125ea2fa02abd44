package br.com.senaisp.bauru.classes;

import javafx.scene.Group;
import javafx.scene.image.Image;
import javafx.scene.image.ImageView;
import javafx.scene.media.AudioClip;

public class Duke extends Group {
	private Image dukeImage;
	private Image luvaImage;
	private AudioClip som;
	//Images Views
	private ImageView dukeImageView;
	private ImageView luvaImageView;
	//Constructor
	public Duke() {
		//Carregando as imagens
		dukeImage = new Image(getClass().getResourceAsStream("Imagens/Duke.png").toString());
		luvaImage = new Image(getClass().getResourceAsStream("Images/Glove.png").toString());
		//Criando os imagesViews
		dukeImageView = new ImageView(dukeImage);
		luvaImageView = new ImageView(luvaImage);
		//Carregando o som
		som = new AudioClip(getClass().getResource("Audios/Note5.wav").toString());
	}
}
