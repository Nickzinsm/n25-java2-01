package projeto_javafx;

import javafx.application.Application;
import javafx.scene.Group;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.layout.StackPane;
import javafx.scene.layout.TilePane;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;

public class JavaFX_Exemplo01 extends Application {

	@Override
	public void start(Stage primaryStage) throws Exception {
		Button btn01 = new Button("Clique para aumentar a velocidade da internet");
		Button btn02 = new Button("Clique para doar corote ao morador de rua");
		// Posicionando botões - Eixo X
		btn01.setLayoutX(150);
		btn02.setLayoutX(150);
		// Eixo Y
		btn01.setLayoutY(175);
		btn02.setLayoutY(350);
		// Criando o container
		//StackPane root = new StackPane();
		//TilePane root = new TilePane();
		//VBox root = new VBox();
		Group root = new Group();
		// Adicionando botões ao painel
		root.getChildren().addAll(btn01, btn02);
		// Criando a scene
		Scene cena = new Scene(root, 600, 400);
		// Amarrando o na principal na tela
		primaryStage.setTitle("Farm Clicker");
		primaryStage.setScene(cena);
		primaryStage.show();
	}

	public static void main(String[] args) {
		launch(args);
	}

}
